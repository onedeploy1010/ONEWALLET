# ONE Wallet Web Dockerfile
# Multi-stage build for production deployment

# Stage 1: Dependencies
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/sdk/package.json ./packages/sdk/
COPY wallet/one-wallet-web/package.json ./wallet/one-wallet-web/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Stage 2: Builder
FROM node:20-alpine AS builder
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/sdk/node_modules ./packages/sdk/node_modules
COPY --from=deps /app/wallet/one-wallet-web/node_modules ./wallet/one-wallet-web/node_modules

# Copy source code
COPY packages/sdk ./packages/sdk
COPY wallet/one-wallet-web ./wallet/one-wallet-web
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./

# Build SDK first
RUN cd packages/sdk && pnpm build

# Build wallet-web
ENV NEXT_TELEMETRY_DISABLED 1
ENV NODE_ENV production

RUN cd wallet/one-wallet-web && pnpm build

# Stage 3: Runner
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV production
ENV NEXT_TELEMETRY_DISABLED 1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy built application
COPY --from=builder /app/wallet/one-wallet-web/public ./public
COPY --from=builder /app/wallet/one-wallet-web/.next/standalone ./
COPY --from=builder /app/wallet/one-wallet-web/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV PORT 3000
ENV HOSTNAME "0.0.0.0"

CMD ["node", "server.js"]
