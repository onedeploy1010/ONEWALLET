# ONE Ecosystem Environment Variables
# Copy this file to .env and fill in your values

# ========================================
# Supabase Database
# ========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-id

# ========================================
# Thirdweb (Web3 Infrastructure)
# Engine centrally manages thirdweb - users don't need their own clientId
# ========================================
THIRDWEB_CLIENT_ID=55c901cbfcccbc3592ae2157f8c7c3b5
THIRDWEB_SECRET_KEY=your-secret-key

# ========================================
# OpenAI (AI Services)
# ========================================
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o

# ========================================
# Trading (Bybit Integration)
# ========================================
BYBIT_API_KEY=your-bybit-api-key
BYBIT_API_SECRET=your-bybit-api-secret
BYBIT_TESTNET=true

# ========================================
# Fiat On/Off Ramp (Onramper)
# Get your API key at: https://onramper.com
# ========================================
ONRAMPER_API_KEY=your-onramper-api-key
ONRAMPER_WEBHOOK_SECRET=your-onramper-webhook-secret
# For SDK components in Next.js apps (public, client-side)
NEXT_PUBLIC_ONRAMPER_API_KEY=your-onramper-api-key

# ========================================
# Security
# ========================================
JWT_SECRET=your-32-character-minimum-secret-key
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=your-32-character-encryption-key
NEXTAUTH_SECRET=your-nextauth-secret

# ========================================
# Redis Cache
# ========================================
REDIS_URL=redis://localhost:6379

# ========================================
# Application Configuration
# ========================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:4000

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Feature Flags
ENABLE_AI_QUANT=true
ENABLE_TRADING=true
ENABLE_FIAT=true

# ========================================
# One Wallet Migration (Optional)
# ========================================
ONE_WALLET_SUPABASE_URL=https://wallet-project.supabase.co
ONE_WALLET_SUPABASE_KEY=wallet-service-role-key

# ========================================
# Docker Compose Ports
# ========================================
ENGINE_PORT=4000
DASHBOARD_PORT=4001
WALLET_WEB_PORT=3000

# ========================================
# Wallet Web Application (Frontend)
# ========================================
# These are automatically fetched from Engine, but can be set as fallback
NEXT_PUBLIC_ENGINE_URL=http://localhost:4000
NEXT_PUBLIC_ONE_ENGINE_URL=http://localhost:4000/api
# Thirdweb clientId is managed by Engine - users don't need their own
# NEXT_PUBLIC_THIRDWEB_CLIENT_ID is fetched from Engine /api/v1/config/thirdweb
