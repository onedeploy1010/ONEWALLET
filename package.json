{
  "name": "@one-ecosystem/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ONE Ecosystem - Unified Web3 infrastructure",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:engine": "turbo build --filter=@one-ecosystem/engine",
    "build:dashboard": "turbo build --filter=@one-ecosystem/dashboard",
    "build:wallet-web": "turbo build --filter=one-wallet-web",
    "dev:engine": "turbo dev --filter=@one-ecosystem/engine",
    "dev:dashboard": "turbo dev --filter=@one-ecosystem/dashboard",
    "dev:wallet-web": "turbo dev --filter=one-wallet-web",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky install"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "prettier": "^3.4.0",
    "typescript": "^5.6.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ]
  }
}
